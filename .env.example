# Set to true only for local UI-only dev (bypasses login with a fake OWNER user).
# MUST be false/unset in any deployed environment.
DISABLE_AUTH=false
DATABASE_URL=postgresql://user:password@localhost:5432/bsl_hub
DATABASE_SSL=false
# Empty = same-origin (this app serves its own /api/bsl and /api/auth routes).
# Only set this if BSL is ever split out to call a separate API host.
NEXT_PUBLIC_API_URL=
# Random secret used to sign session cookies — generate with `openssl rand -hex 32`.
# Changing this invalidates all existing sessions.
SESSION_SECRET=
INTERNAL_SECRET=
MAIN_SERVER_URL=http://localhost:5000
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
